<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Sentry.AspNetCore" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADManager.Application\ADManager.Application.csproj" />
    <ProjectReference Include="..\ADManager.Infrastructure\ADManager.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    wwwroot is served as-is via UseStaticFiles (see Program.cs) but is not
    otherwise wired into the build, so a stale wwwroot silently ships old
    frontend assets. BuildFrontend regenerates the Vite dist/ output and
    syncs it into wwwroot before Build/Publish so this can't happen unnoticed.
  -->
  <PropertyGroup>
    <FrontendProjectDir>$(MSBuildThisFileDirectory)..\..\frontend\ad-manager-ui\</FrontendProjectDir>
    <FrontendDistDir>$(FrontendProjectDir)dist\</FrontendDistDir>
    <WwwrootDir>$(MSBuildThisFileDirectory)wwwroot\</WwwrootDir>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild;ResolveProjectStaticWebAssets">
    <Exec Command="npm run build" WorkingDirectory="$(FrontendProjectDir)" />
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendDistDir)**\*" />
      <StaleWwwrootFiles Include="$(WwwrootDir)**\*" Exclude="$(FrontendDistDir)**\*" />
    </ItemGroup>
    <Delete Files="@(StaleWwwrootFiles)" />
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFolder="$(WwwrootDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
    <!-- The wwwroot glob was evaluated before this target replaced the hashed
         Vite files; re-glob so static web assets see the new names. -->
    <ItemGroup>
      <!-- Match by identity: a Remove glob only sees files still on disk, so it
           would miss the stale entries that were just deleted. -->
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('wwwroot'))" />
      <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    appsettings.secrets.json is a gitignored, DPAPI-encrypted (LocalMachine-scope)
    local dev config source (see Program.cs) - it must never ship in a build/publish
    output, since it's meaningless (undecryptable) on any other machine and its
    presence in a release artifact is itself a secrets-handling defect regardless.
  -->
  <ItemGroup>
    <Content Remove="appsettings.secrets.json" />
  </ItemGroup>

</Project>
